# Postgres de destino. Local via brew, Docker, Neon ou Supabase - a URL eh a mesma coisa.
DATABASE_URL=postgresql://localhost:5432/transparencia

# Sal do hash de CPF. NUNCA versionar o valor real e NUNCA trocar depois de carregar dados:
# trocar o sal invalida todas as chaves de juncao ja gravadas.
CPF_SALT=troque-isto-por-um-valor-aleatorio-longo

# Token gratuito do Portal da Transparencia (cadastro no gov.br). So necessario na Fase 3.
PORTAL_TRANSPARENCIA_TOKEN=

# Token do painel de administracao. Minimo 32 caracteres. Apenas desenvolvimento:
# em producao use FIREBASE_CREDENTIALS e o claim de administrador.
ADMIN_TOKEN=
